# ─── Regenerated / derived data — NOT committed ────────────────────────────
# The 127 synthetic disk images (tens of GB) are rebuilt byte-deterministically
# by the generators in src/generators/. Do not commit them.
*.img
*.dd
*.raw
*.iso
*.bin
/dataset/

# Carved output tree (6 tools x 134 images). Rebuilt by running the carvers.
# The *scored* results ARE committed, under eval/results/ — so these patterns
# are anchored with a leading slash. A bare "results/" would match at ANY depth
# and would silently exclude eval/results/ too.
/results/
/full_carved_output/

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── SCAR run artefacts ────────────────────────────────────────────────────
*.map
*.idx
*.duplicate
*.rejected
*.objscan.pdf
_c9_repairs.txt
_work/
*.log

# ─── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*.bak
