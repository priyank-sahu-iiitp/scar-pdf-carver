*.map
*.idx
*.duplicate
*.rejected
*.objscan.pdf
_c9_repairs.txt
_work/
*.log

# ─── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*.bak
